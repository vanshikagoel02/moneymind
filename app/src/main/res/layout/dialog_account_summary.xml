<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Your account"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/tvAccountDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Riya Sharma · riya@example.com"
        android:textColor="@color/blue_brand"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAccountProfile"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/navy_primary"
            android:paddingHorizontal="16dp"
            android:text="Profile &amp; settings"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAccountLogout"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/navy_secondary"
            android:paddingHorizontal="16dp"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAccountClose"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="16dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
